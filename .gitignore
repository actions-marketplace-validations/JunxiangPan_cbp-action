__pycache__/
*.py[cod]
.coverage
*.egg-info/
dist/
dist-verify/
build/

# Never commit a build artifact: the build-artifact job is the only producer.
*.whl
*.tar.gz

# Generated by the coverage step; embeds the commit fingerprint, so it can
# never be consistent with the commit that contains it.
coverage.json

# Generated by the dogfood job; never commit.
quality-manifest.json
quality-manifest.json.sha256
docs/RELEASE_NOTES.generated.md

# Scratch workspace for local audits; never commit.
.tmp-*

# Local audit scratch; never commit.
.audit-*
