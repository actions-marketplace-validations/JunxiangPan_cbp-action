{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBP provenance sidecar (SLSA-shaped)",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate", "manifest_sha256", "manifest_artifact_hashes", "signature_status"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "predicateType": {"const": "https://slsa.dev/provenance/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_artifact_hashes": {"type": "object"},
    "signature_status": {"enum": ["SIGNED", "BLOCKED_NO_SIGNING_IDENTITY"]},
    "predicate": {"type": "object"}
  },
  "additionalProperties": false
}
