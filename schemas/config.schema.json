{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBP config",
  "type": "object",
  "properties": {
    "coverage_json": {
      "type": "string"
    },
    "coverage_allowlist": {
      "type": "string"
    },
    "target_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_file": {
      "type": "string"
    },
    "coverage_threshold": {
      "type": "number"
    },
    "policy_threshold": {
      "type": "number"
    },
    "dependency_lock": {
      "type": "string"
    },
    "install_command": {
      "type": "string"
    },
    "docs_manifest": {
      "type": "string"
    },
    "comment_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "binary_artifacts": {
      "type": "string"
    },
    "binary_limit_mb": {
      "type": "number"
    },
    "package_zip": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims_manifest": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "enable_coverage": {
      "type": "boolean"
    },
    "enable_dependency": {
      "type": "boolean"
    },
    "enable_comments": {
      "type": "boolean"
    },
    "enable_docs": {
      "type": "boolean"
    },
    "enable_binary": {
      "type": "boolean"
    },
    "enable_claims": {
      "type": "boolean"
    },
    "coverage_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "files",
          "threshold",
          "mode"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "threshold": {
            "type": "number"
          },
          "mode": {
            "enum": [
              "enforce",
              "warn"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "enable_encoding": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "custom_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_readers": {
      "type": "object"
    },
    "release_body": {
      "type": "string"
    },
    "coverage_signature": {
      "type": "string"
    },
    "require_coverage_signature": {
      "type": "boolean"
    },
    "enable_custom": {
      "type": "boolean"
    },
    "baseline": {
      "type": "string"
    },
    "required_artifacts": {
      "type": "array",
      "description": "Required when package_zip is configured."
    },
    "packs": {
      "type": "array"
    },
    "enable_deep_scan": {
      "type": "boolean"
    },
    "ast_max_bytes": {
      "type": "integer"
    },
    "external_reports": {
      "type": "array"
    },
    "scan_engine": {
      "type": "string",
      "enum": [
        "python",
        "cel"
      ]
    },
    "release_version": {
      "type": "string"
    },
    "release_artifact": {
      "type": "string"
    },
    "pypi_project": {
      "type": "string"
    },
    "artifact_repository": {
      "type": "string",
      "description": "owner/repo that owns the build artifacts; recorded in the manifest and checked by --expected-repository."
    },
    "cbc_event": {
      "type": "object",
      "description": "cbc-event 0.1.x emission; disabled unless enabled and dir are set.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "dir": {
          "type": "string"
        },
        "max_events": {
          "type": "integer",
          "minimum": 0,
          "default": 1000
        },
        "hmac_key_env": {
          "type": "string",
          "description": "Environment variable holding an HMAC-SHA256 key."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version"
  ]
}
